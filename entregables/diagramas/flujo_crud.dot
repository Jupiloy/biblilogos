
digraph G {
  rankdir=LR; node [shape=box, style="rounded,filled", fillcolor="#F8CECC", fontname="Arial"];
  Solicitud [label="Solicitud HTTP"];
  Pydantic [label="Validación Pydantic"];
  Servicio [label="ServicioCatalogo"];
